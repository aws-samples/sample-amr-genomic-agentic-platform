    "SraFetcherTask962B97F7": {
      "Properties": {
        "ContainerDefinitions": [
          {
            "Command": [
              "chown 1000:1000 /tmp/fastq && chmod 0770 /tmp/fastq",
            ],
            "EntryPoint": [
              "/bin/sh",
              "-c",
            ],
            "Essential": false,
            "Image": "123456789012.dkr.ecr.us-west-2.amazonaws.com/cdk-hnb659fds-container-assets-123456789012-us-west-2:abc123",
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "SraFetcherLogGroupF8694FA7",
                },
                "awslogs-region": "us-west-2",
                "awslogs-stream-prefix": "scratch-init",
              },
            },
            "MountPoints": [
              {
                "ContainerPath": "/tmp/fastq",
                "ReadOnly": false,
                "SourceVolume": "scratch",
              },
            ],
            "Name": "scratch-init",
            "ReadonlyRootFilesystem": true,
            "User": "0:0",
          },
          {
            "DependsOn": [
              {
                "Condition": "SUCCESS",
                "ContainerName": "scratch-init",
              },
            ],
            "Environment": [
              {
                "Name": "OUTPUT_DIR",
                "Value": "/tmp/fastq",
              },
              {
                "Name": "AWS_DEFAULT_REGION",
                "Value": "us-west-2",
              },
              {
                "Name": "S3_OUTPUT_BUCKET",
                "Value": "test-prefix-amr-data-lake",
              },
            ],
            "Essential": true,
            "Image": "123456789012.dkr.ecr.us-west-2.amazonaws.com/cdk-hnb659fds-container-assets-123456789012-us-west-2:abc123",
            "LinuxParameters": {
              "Capabilities": {},
              "InitProcessEnabled": true,
            },
