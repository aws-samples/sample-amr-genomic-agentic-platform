        "State": "ENABLED",
        "Target": {
          "Arn": {
            "Ref": "AmrPipeline535350EC",
          },
          "Input": "{"isolates":[{"isolate_id":"isolate-SRR1583085","accession":"SRR1583085","source":"ncbi-sra-public","source_provenance":"NCBI SRA Public","license":"US Government public domain (NCBI SRA)","run_id":"weekly-test-run-id"}],"run_id":"weekly-test-run-id","triggeredBy":"scheduler"}",
