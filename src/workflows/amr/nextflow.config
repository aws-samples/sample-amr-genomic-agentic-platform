// AMR genomics workflow — Nextflow configuration for AWS HealthOmics.
//
// Container images are supplied at runtime as workflow parameters
// (params.assembly_container, params.amr_container) rather than hardcoded here,
// so the workflow is account and Region agnostic. See main.nf.

manifest {
    name        = 'amr-genomics'
    description = 'AMR genomics: fastp QC + SKESA de novo assembly + AMRFinderPlus screening'
    version     = '2.0.0'
    nextflowVersion = '>=23.04'
}

process {
    // Per-task resource selectors. Container directives are set in main.nf from
    // the image-URI parameters.
    withName: 'FASTP' {
        cpus   = 4
        memory = '8 GB'
    }
    withName: 'SKESA' {
        cpus   = 8
        memory = '32 GB'
    }
    withName: 'AMRFINDERPLUS' {
        cpus   = 4
        memory = '8 GB'
    }
}

aws {
    region = 'us-west-2'
}
